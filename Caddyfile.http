http://{$GRD_LAN_IP} {
	header {
		-Server
		Referrer-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	handle /healthz {
		respond "ok" 200
	}

	handle /api/v1/* {
		reverse_proxy 127.0.0.1:3000 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}
}
