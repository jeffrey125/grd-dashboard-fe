# Copy to .env.lan for local image/container verification or to .env beside the
# Compose file on the LAN host. Never commit the populated file.
GRD_RELEASE=20261017-01
GRD_BACKEND_IMAGE=grd-dashboard-be:20261017-01
GRD_FRONTEND_IMAGE=grd-dashboard-fe:20261017-01
GRD_LAN_IP=192.168.100.83
GRD_ORIGIN=https://192.168.100.83

GRD_DB_NAME=grd_dashboard
GRD_DB_USER=grd_dashboard
GRD_DB_PASSWORD=replace-with-a-random-value
GRD_AUTH_SECRET=replace-with-at-least-32-random-characters
LOG_LEVEL=info

# Configure these before starting the worker profile. A fresh database enables
# all three Carriers; leaving the worker stopped prevents live provider requests.
UPS_ENVIRONMENT=cie
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
AMAZON_SP_API_SANDBOX_CLIENT_ID=
AMAZON_SP_API_SANDBOX_CLIENT_SECRET=
AMAZON_SP_API_SANDBOX_REFRESH_TOKEN=
MYUNISHIPPERS_EMAIL=
MYUNISHIPPERS_PASSWORD=
ECHOSHIP_URL=https://echoship.com/login
ECHOSHIP_USERNAME=
ECHOSHIP_PASSWORD=
FFE_URL=https://www.ffeinc.com/Customer/ShipmentTracking
FFE_USERNAME=
FFE_PASSWORD=
NTFY_URL=
