# Explicitly insecure HTTP-only LAN profile. Do not expose beyond a trusted LAN.
# Generate a populated file with:
# pnpm env:lan --scheme http --release YYYYMMDD-NN --output .env.lan-http
GRD_RELEASE=20261017-01
GRD_BACKEND_IMAGE=grd-dashboard-be:20261017-01
GRD_FRONTEND_IMAGE=grd-dashboard-fe:http-20261017-01
GRD_LAN_IP=192.168.100.83
GRD_HTTP_PORT=80
GRD_ORIGIN=http://192.168.100.83
GRD_HTTP_ONLY=true

GRD_DB_NAME=grd_dashboard
GRD_DB_USER=grd_dashboard
GRD_DB_PASSWORD=replace-with-a-random-value
GRD_AUTH_SECRET=replace-with-at-least-32-random-characters
LOG_LEVEL=info

UPS_ENVIRONMENT=cie
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
